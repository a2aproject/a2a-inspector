{
  "name": "a2a-inspector-ui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('node:fs').writeFileSync('node_modules/go.mod', 'module ignore\\n')\"",
